---
// Sticky booking + call CTA — modeled on the naxossailing StickyMobileCTA:
// a frosted pill that reveals once the user scrolls into the page and hides
// again near the top. Adapted to Physio Dynamic branding.
import { site } from '../data/site';
---
<div class="sticky-cta" role="region" aria-label="Γρήγορες ενέργειες" data-sticky-cta>
  <div class="sc-shell">
    <a class="sc-icon" href={`tel:00302117506000`} aria-label={`Καλέστε ${site.phoneDisplay}`}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.9.36 1.78.7 2.6a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.48-1.48a2 2 0 0 1 2.11-.45c.82.34 1.7.57 2.6.7A2 2 0 0 1 22 16.92Z"/>
      </svg>
    </a>
    <span class="sc-phone">{site.phoneDisplay}</span>
    <span class="sc-divider" aria-hidden="true"></span>
    <a class="sc-cta" href={site.bookingUrl} target="_blank" rel="noopener">
      <span class="sc-live" aria-hidden="true"></span>
      <span class="sc-cta-text">Κλείσε ραντεβού online</span>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0; right: 0;
    bottom: 0;
    z-index: 900;
    padding: 12px 12px calc(12px + env(safe-area-inset-bottom));
    display: flex;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(130%);
    transition: opacity 300ms ease, transform 380ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sticky-cta[data-revealed] { opacity: 1; transform: translateY(0); }

  .sc-shell {
    pointer-events: none;
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: 5px;
    width: 100%;
    max-width: 520px;
    background: color-mix(in srgb, var(--color-primary) 92%, transparent);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    color: #fff;
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow: 0 14px 36px rgba(0, 8, 127, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .sticky-cta[data-revealed] .sc-shell { pointer-events: auto; }

  .sc-icon {
    flex: 0 0 auto;
    width: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.85);
    border-radius: 10px;
    transition: color 200ms, background 200ms, transform 120ms;
  }
  .sc-icon:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .sc-icon:active { transform: scale(0.92); }
  .sc-phone { display: inline-flex; align-items: center; font-weight: 700; font-size: 0.92rem; padding-right: 4px; }

  .sc-divider { width: 1px; margin: 11px 0; background: rgba(255, 255, 255, 0.14); }

  .sc-cta {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-left: 6px;
    padding: 12px 16px;
    background: var(--color-accent);
    color: var(--color-primary-dark);
    border-radius: 10px;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 800;
    white-space: nowrap;
    transition: filter 180ms, transform 120ms;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .sc-cta:hover { filter: brightness(1.05); }
  .sc-cta:active { transform: scale(0.985); }
  .sc-cta svg { flex-shrink: 0; transition: transform 220ms; }
  .sc-cta:hover svg { transform: translateX(2px); }

  .sc-live {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-primary-dark);
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(0, 8, 127, 0.5);
    animation: scLive 2.4s ease-out infinite;
  }
  @keyframes scLive {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 8, 127, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(0, 8, 127, 0); }
  }

  @media (max-width: 560px) {
    .sc-phone { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta { transition: opacity 200ms; transform: none; }
    .sc-live { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    function bind() {
      var bar = document.querySelector('[data-sticky-cta]');
      if (!bar) return;
      var vh = window.innerHeight;
      var hideAt = 80;
      var raf = 0;
      function update() {
        var y = window.pageYOffset || 0;
        var showAt = vh * 0.5;
        var revealed = bar.hasAttribute('data-revealed');
        var atBottom = (window.innerHeight + y) >= (document.body.scrollHeight - 4);
        if (!revealed && y > showAt && !atBottom) bar.setAttribute('data-revealed', '');
        else if (revealed && (y < hideAt || atBottom)) bar.removeAttribute('data-revealed');
        raf = 0;
      }
      function onScroll() { if (!raf) raf = requestAnimationFrame(update); }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', function () { vh = window.innerHeight; }, { passive: true });
      requestAnimationFrame(update);
    }
    if (!window.__pdStickyCta) {
      window.__pdStickyCta = true;
      if (document.readyState === 'complete') bind();
      else window.addEventListener('load', bind, { once: true });
    }
  })();
</script>
