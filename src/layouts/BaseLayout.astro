---
import '../styles/global.css';
// Hashed URLs of the critical font files so we can preload them (body 400 / bold 700).
import fontLatin400 from '@fontsource/google-sans/files/google-sans-latin-400-normal.woff2?url';
import fontGreek400 from '@fontsource/google-sans/files/google-sans-greek-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import StickyCTA from '../components/StickyCTA.astro';
import WebMCP from '../components/WebMCP.astro';
import { site } from '../data/site';
import { businessSchema, websiteSchema } from '../data/schema';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  jsonLd?: any[];
}
const {
  title,
  description = 'Physio Dynamic — σύγχρονο κέντρο φυσικοθεραπείας στο Παλαιό Φάληρο. McKenzie, Manual Therapy, Βελονισμός, Shockwave, Pilates & αποκατάσταση.',
  ogImage,
  bodyClass,
  jsonLd = [],
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// Structured data: site-wide business + website entity, plus any page-specific schema.
const schemas = [businessSchema(), websiteSchema(), ...jsonLd].filter(Boolean);
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#10327c" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="el_GR" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.ico" />

  <!-- Google Sans: self-hosted. Preload only the body (400) weights — the bold
       files swap in via CSS without competing with the LCP image download. -->
  <link rel="preload" href={fontLatin400} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={fontGreek400} as="font" type="font/woff2" crossorigin />

  <!-- Structured data (JSON-LD) -->
  {schemas.map((s) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
  ))}

  <!-- Google Consent Mode default (EU region) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_personalization: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      security_storage: 'denied',
      personalization_storage: 'denied',
      region: ['AT','BE','BG','CH','CY','CZ','DE','DK','EE','ES','FI','FR','GB','GR','HR','HU','IE','IS','IT','LI','LT','LU','LV','MT','NL','NO','PL','PT','RO','SE','SI','SK'],
      wait_for_update: 500
    });
    gtag('set', 'ads_data_redaction', true);
    gtag('set', 'url_passthrough', true);
  </script>

  <!-- Re-apply stored cookie consent (before tags fire) -->
  <script is:inline>
    (function () {
      try {
        var m = document.cookie.match(/(?:^|; )pd_consent=([^;]*)/);
        if (!m) return;
        var c = JSON.parse(decodeURIComponent(m[1]));
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'update', {
          analytics_storage: c.analytics ? 'granted' : 'denied',
          ad_storage: c.ads ? 'granted' : 'denied',
          ad_user_data: c.ads ? 'granted' : 'denied',
          ad_personalization: c.ads ? 'granted' : 'denied',
          functionality_storage: c.functional ? 'granted' : 'denied',
          personalization_storage: c.functional ? 'granted' : 'denied',
          security_storage: 'granted'
        });
      } catch (e) {}
    })();
  </script>

  <!-- Google tag (gtag.js) + GTM — DEFERRED until first user interaction (or ~6s
       fallback) so 200+ KB of third-party JS never blocks the initial render.
       All dataLayer pushes made before load are queued and flushed by gtag itself. -->
  <script is:inline define:vars={{ gtagId: site.analytics.gtag, adsId: site.analytics.ads, gtmId: site.analytics.gtm }}>
    (function () {
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Queue the config now — flushed when gtag.js loads.
      gtag('js', new Date());
      var noLinker = { linker: { accept_incoming: false, decorate_forms: false, domains: [] } };
      gtag('config', gtagId, noLinker);
      gtag('config', adsId, noLinker);

      var loaded = false;
      function loadTags() {
        if (loaded) return;
        loaded = true;
        var a = document.createElement('script');
        a.async = true;
        a.src = 'https://www.googletagmanager.com/gtag/js?id=' + gtagId;
        document.head.appendChild(a);
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var b = document.createElement('script');
        b.async = true;
        b.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
        document.head.appendChild(b);
      }
      var evts = ['pointerdown', 'touchstart', 'keydown', 'scroll', 'mousemove'];
      function once() {
        loadTags();
        evts.forEach(function (ev) { window.removeEventListener(ev, once); });
      }
      evts.forEach(function (ev) { window.addEventListener(ev, once, { once: false, passive: true }); });
      // Fallback: users who never interact still get tracked shortly after load.
      window.addEventListener('load', function () { setTimeout(loadTags, 6000); });
    })();
  </script>

  <!-- Strip _gl / _ga / gclid tracking params from the URL so the address bar stays clean -->
  <script is:inline>
    (function () {
      try {
        var url = new URL(window.location.href);
        var noise = ['_gl', '_ga', 'gclid', 'gbraid', 'wbraid'];
        var changed = false;
        noise.forEach(function (k) {
          if (url.searchParams.has(k)) { url.searchParams.delete(k); changed = true; }
        });
        if (changed) window.history.replaceState({}, '', url.toString());
      } catch (e) {}
    })();
  </script>

  <slot name="head" />
</head>
<body class={bodyClass}>
  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe src={`https://www.googletagmanager.com/ns.html?id=${site.analytics.gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>

  <a href="#main" class="skip-link">Παράβλεψη πλοήγησης</a>

  <Header />

  <main id="main" data-pagefind-body>
    <slot />
  </main>

  <Footer />

  <StickyCTA />
  <CookieConsent />
  <WebMCP />

  <style>
    .skip-link { position: absolute; left: -9999px; top: 0; background: var(--color-primary); color: #fff; padding: 0.75rem 1rem; z-index: 200; }
    .skip-link:focus { left: 0; }
  </style>
</body>
</html>
