---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { servicePages } from '../data/services';
import { posts } from '../data/posts';
import { site } from '../data/site';
import { serviceSchema, breadcrumb, faqFromSections, blogPosting, faqPage } from '../data/schema';
import { pillarFaqs, fmsComparison, serviceVideos, postVideos } from '../data/pillar-content';

type Entry =
  | { type: 'service'; page: (typeof servicePages)[number] }
  | { type: 'post'; post: (typeof posts)[number] };

export async function getStaticPaths() {
  const { servicePages: svc } = await import('../data/services');
  const { posts: p } = await import('../data/posts');
  return [
    ...svc.map((page) => ({ params: { slug: page.slug }, props: { type: 'service' as const, page } })),
    ...p.map((post) => ({ params: { slug: post.slug }, props: { type: 'post' as const, post } })),
  ];
}

const props = Astro.props as Entry;

const pageFaqs = props.type === 'service' ? pillarFaqs[props.page.slug] : undefined;
const pageVideos =
  props.type === 'service' ? serviceVideos[props.page.slug] : postVideos[props.post.slug];

// Branded placeholder shown on video cards before the user presses play.
const LOGO = '/wp-content/uploads/2022/03/cropped-logo-%CE%99%CF%89%CE%AC%CE%BD%CE%BD%CE%B7%CF%82-%CE%9A%CF%89%CF%84%CE%BF%CF%85%CE%BB%CE%B1%CF%82-e1648814356905.jpg';
const comparison = props.type === 'service' && fmsComparison.slug === props.page.slug ? fmsComparison : null;

const serviceJsonLd = props.type === 'service'
  ? [
      serviceSchema(props.page),
      breadcrumb([
        { name: 'Αρχική', url: '/' },
        { name: props.page.title, url: `/${props.page.slug}/` },
      ]),
      pageFaqs ? faqPage(pageFaqs) : faqFromSections(props.page.sections as any[]),
    ].filter(Boolean)
  : [];

const postJsonLd = props.type === 'post'
  ? [
      blogPosting(props.post as any),
      breadcrumb([
        { name: 'Αρχική', url: '/' },
        { name: 'Blog', url: '/category/physiodynamic-blog/' },
        { name: props.post.title, url: `/${props.post.slug}/` },
      ]),
    ]
  : [];
---
{props.type === 'service' && (
  <PageLayout
    title={props.page.title}
    description={props.page.description}
    heroImage={props.page.heroImage}
    heroAlt={props.page.heroAlt}
    eyebrow="Υπηρεσία"
    breadcrumb={[{ label: props.page.title, href: `/${props.page.slug}/` }]}
    jsonLd={serviceJsonLd}
  >
    {props.page.sections.map((section) => (
      <section class:list={["page-section", section.lead && "lead-section"]}>
        {section.heading && <h2>{section.heading}</h2>}
        {section.body && <p>{section.body}</p>}
        {section.bullets && (
          <ul>
            {section.bullets.map((b) => <li>{b}</li>)}
          </ul>
        )}
      </section>
    ))}

    {comparison && (
      <section class="page-section compare-section">
        <h2>{comparison.heading}</h2>
        <p>{comparison.intro}</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <thead>
              <tr>{comparison.columns.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {comparison.rows.map((row) => (
                <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {pageFaqs && (
      <section class="page-section faq-section">
        <h2>Συχνές Ερωτήσεις</h2>
        <div class="svc-faq">
          {pageFaqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="svc-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </section>
    )}

    <aside class="author-box" aria-label="Συντάκτης">
      <div class="author-meta">
        <p class="author-name">{site.owner}</p>
        <p class="author-role">Φυσικοθεραπευτής · Υπεύθυνος Physio Dynamic</p>
        <p class="author-desc">Το περιεχόμενο επιμελείται η ομάδα του Physio Dynamic, σύγχρονου κέντρου φυσικοθεραπείας στο Παλαιό Φάληρο, με εξειδίκευση σε σύγχρονες μεθόδους αποκατάστασης.</p>
      </div>
    </aside>

    {pageVideos && (
      <section slot="below" class="video-section">
        <h2 class="video-heading">Δείτε στην πράξη</h2>
        <div class="yt-grid">
          {pageVideos.map((v) => (
            <div class:list={["yt-frame", v.portrait && "yt-portrait"]}>
              <button
                type="button"
                class="yt-facade"
                data-yt={v.id}
                data-title={v.title}
                aria-label={`Αναπαραγωγή βίντεο: ${v.title}`}
              >
                <span class="yt-logo"><img src={LOGO} alt="" loading="lazy" decoding="async" width="180" height="34" /></span>
                <span class="yt-play" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
                <span class="yt-title">{v.title}</span>
              </button>
            </div>
          ))}
        </div>
      </section>
    )}
  </PageLayout>

  <style>
    .compare-wrap { overflow-x: auto; }
    .compare-table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 1rem; font-size: 0.95rem; }
    .compare-table th, .compare-table td { border: 1px solid var(--color-border); padding: 0.65rem 0.85rem; text-align: left; vertical-align: top; }
    .compare-table thead th { background: var(--color-primary); color: #fff; }
    .compare-table tbody th[scope="row"] { background: var(--color-bg-alt); font-weight: 700; color: var(--color-primary); }
    .svc-faq details { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); margin-bottom: 0.6rem; overflow: hidden; }
    .svc-faq summary { padding: 0.9rem 1.1rem; cursor: pointer; font-family: var(--font-heading); font-weight: 700; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .svc-faq summary::after { content: '+'; font-size: 1.4rem; color: var(--color-primary); }
    .svc-faq details[open] summary::after { content: '−'; }
    .svc-faq-a { padding: 0 1.1rem 1rem; color: var(--color-text-muted); }
    .author-box { margin-top: 2.5rem; padding: 1.25rem 1.5rem; border-left: 3px solid var(--color-accent); background: var(--color-bg-alt); border-radius: var(--radius); }
    .author-name { font-weight: 700; color: var(--color-primary); margin: 0; }
    .author-role { font-size: 0.9rem; color: var(--color-text-muted); margin: 0.15rem 0 0.5rem; }
    .author-desc { font-size: 0.9rem; color: var(--color-text-muted); margin: 0; }
  </style>
)}

{props.type === 'post' && (
  <BaseLayout title={props.post.title} description={props.post.excerpt} ogImage={props.post.heroImage} jsonLd={postJsonLd}>
    <article class="post">
      <header class="post-hero">
        <div class="wrap">
          <nav class="crumbs" aria-label="breadcrumb">
            <a href="/">Αρχική</a><span>›</span>
            <a href="/category/physiodynamic-blog/">Blog</a><span>›</span>
            <span>{props.post.title}</span>
          </nav>
          <p class="eyebrow">Blog · {props.post.dateDisplay}</p>
          <h1>{props.post.title}</h1>
          {props.post.author && <p class="byline">από {props.post.author}</p>}
        </div>
      </header>

      <div class="wrap post-body">
        {props.post.heroImage && (
          <figure class="post-figure">
            <img src={props.post.heroImage} alt={props.post.heroAlt || props.post.title} loading="lazy" />
          </figure>
        )}
        <div class="post-content" set:html={props.post.bodyHtml.replace(/<(\/?)h3\b/g, '<$1h2')}></div>

        {pageVideos && (
          <section class="video-section">
            <h2 class="video-heading">Σχετικό βίντεο</h2>
            <div class="yt-grid">
              {pageVideos.map((v) => (
                <div class:list={["yt-frame", v.portrait && "yt-portrait"]}>
                  <button
                    type="button"
                    class="yt-facade"
                    data-yt={v.id}
                    data-title={v.title}
                    aria-label={`Αναπαραγωγή βίντεο: ${v.title}`}
                  >
                    <span class="yt-logo"><img src={LOGO} alt="" loading="lazy" decoding="async" width="180" height="34" /></span>
                    <span class="yt-play" aria-hidden="true">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </span>
                    <span class="yt-title">{v.title}</span>
                  </button>
                </div>
              ))}
            </div>
          </section>
        )}

        <div class="post-cta">
          <p>Χρειάζεστε φυσικοθεραπευτική αξιολόγηση;</p>
          <a href={site.bookingUrl} target="_blank" rel="noopener" class="btn btn-accent">Κλείσε ραντεβού online</a>
          <a href={`tel:00302117506000`} class="btn">Καλέστε {site.phoneDisplay}</a>
        </div>

        <p class="back-link"><a href="/category/physiodynamic-blog/">← Επιστροφή στο blog</a></p>
      </div>
    </article>
  </BaseLayout>
)}

<style>
  .page-section { margin-bottom: 1.5rem; }
  .lead-section p { font-size: 1.15rem; color: var(--color-text); }

  .post-hero { background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%); color: #fff; padding: 3rem 0 2.5rem; }
  .post-hero h1 { color: #fff; }
  .post-hero .eyebrow { color: var(--color-accent); }
  .byline { opacity: 0.8; margin: 0; }
  .crumbs { font-size: 0.85rem; margin-bottom: 1rem; color: rgba(255,255,255,0.7); display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .crumbs a { color: rgba(255,255,255,0.85); }

  .post-body { max-width: 780px; padding: 3rem 1.25rem; }
  .post-figure { margin: 0 0 2rem; }
  /* Fixed aspect ratio reserves the image's space before it loads (CLS = 0). */
  .post-figure img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius); }
  .post-content :global(h2), .post-content :global(h3) { margin-top: 2rem; color: var(--color-primary); }
  .post-content :global(h2) { font-size: 1.35rem; }
  .post-content :global(p) { margin-bottom: 1.15em; line-height: 1.7; }
  .post-content :global(.source) { color: var(--color-text-muted); font-size: 0.9rem; margin-top: 2rem; }
  .post-content :global(.post-table-wrap) { overflow-x: auto; margin: 1.75rem 0; }
  .post-content :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .post-content :global(th), .post-content :global(td) { border: 1px solid var(--color-border); padding: 0.65rem 0.85rem; text-align: left; vertical-align: top; }
  .post-content :global(thead th) { background: var(--color-primary); color: #fff; font-family: var(--font-heading); }
  .post-content :global(tbody th) { background: var(--color-bg-alt); color: var(--color-primary); font-weight: 700; }
  .post-content :global(tbody tr:nth-child(even)) { background: var(--color-bg-alt); }

  .post-cta { margin: 3rem 0 2rem; padding: 1.75rem; background: var(--color-bg-alt); border-radius: var(--radius); text-align: center; }
  .post-cta p { font-family: var(--font-heading); text-transform: uppercase; font-weight: 700; margin-bottom: 1rem; }
  .post-cta .btn { margin: 0.25rem; }

  .back-link { margin-top: 2rem; }

  /* --- YouTube click-to-play facades (no iframe until the user presses play).
         Cards show a branded Physio Dynamic placeholder, not YouTube's auto-thumbnail. --- */
  :global(.page-below) { padding-bottom: 1rem; }
  :global(.video-section) { margin: 2.5rem 0 1.5rem; }
  :global(.video-heading) { color: var(--color-primary); margin-bottom: 0.25rem; }
  :global(.yt-grid) { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.25rem; }
  :global(.yt-frame) { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--color-primary-dark); aspect-ratio: 16 / 9; flex: 1 1 560px; max-width: 720px; }
  :global(.yt-frame.yt-portrait) { aspect-ratio: 9 / 16; flex: 0 1 270px; max-width: 280px; min-width: 210px; }
  :global(.yt-frame iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  :global(.yt-facade) { position: absolute; inset: 0; width: 100%; height: 100%; padding: 1rem; border: 0; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%); }
  :global(.yt-logo) { background: #fff; border-radius: 10px; padding: 0.55rem 0.9rem; display: inline-flex; box-shadow: 0 4px 14px rgba(0,0,0,0.25); }
  :global(.yt-logo img) { width: 170px; max-width: 100%; height: auto; display: block; }
  :global(.yt-play) { width: 60px; height: 60px; border-radius: 50%; background: rgba(255, 0, 0, 0.92); color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.4); transition: transform 0.15s ease, background 0.15s ease; }
  :global(.yt-facade:hover .yt-play), :global(.yt-facade:focus-visible .yt-play) { background: #f00; transform: scale(1.08); }
  :global(.yt-title) { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.6rem 0.75rem; font-size: 0.85rem; font-weight: 700; color: #fff; text-align: left; background: linear-gradient(transparent, rgba(0,0,0,0.65)); }
  @media (max-width: 640px) {
    :global(.yt-frame) { flex-basis: 100%; }
    :global(.yt-frame.yt-portrait) { flex: 0 1 calc(50% - 0.65rem); min-width: 150px; }
    :global(.yt-logo img) { width: 120px; }
  }
</style>

<script>
  // Swap a facade for the real YouTube iframe only when the user presses play.
  document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.yt;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1&rel=0`;
      iframe.title = btn.dataset.title || 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>
